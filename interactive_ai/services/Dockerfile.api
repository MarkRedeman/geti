COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/aiosignal /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/aiosignal
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/aiosignal-1.4.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/aiosignal-1.4.0.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/async_timeout /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/async_timeout
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/async_timeout-5.0.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/async_timeout-5.0.1.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/frozenlist /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/frozenlist
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/frozenlist-1.8.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/frozenlist-1.8.0.dist-info
