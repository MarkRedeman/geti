COPY --link --from=build-model_registration /interactive_ai/services/model_registration/.venv/lib/python3.10/site-packages/moto /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/moto
COPY --link --from=build-model_registration /interactive_ai/services/model_registration/.venv/lib/python3.10/site-packages/moto-5.0.2.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/moto-5.0.2.dist-info
COPY --link --from=build-model_registration /interactive_ai/services/model_registration/.venv/lib/python3.10/site-packages/asynctest /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/asynctest
COPY --link --from=build-model_registration /interactive_ai/services/model_registration/.venv/lib/python3.10/site-packages/asynctest-0.13.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/asynctest-0.13.0.dist-info
