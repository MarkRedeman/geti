# syntax=docker/dockerfile:1.7
# Shared runtime image for all interactive_ai Python API services.
# Build context: ./interactive_ai/services
# Additional contexts: libs, iai_core, media_utils, supported_models, schemas, otx
#
# Venv grouping (intermediate shared-venv approach):
#   env_core              <- build-auto_train (resource + auto_train overlay)
#   env_director          <- build-director   (director)
#   env_ie                <- build-dataset_ie (dataset_import_export, project_import_export)
#   env_jobs              <- build-jobs       (jobs, jobs_scheduler, jobs_policy, jobs_worker)
#   env_visual_prompt     <- build-visual_prompt (visual_prompt)
#   env_model_registration <- build-model_registration (model_registration)

FROM python:3.10-slim-bookworm@sha256:23f63358922e79a794f71be8f3723c84e5ccca9638af3f74456dc73d6184499e AS base

FROM public.ecr.aws/debian/debian:12.8-slim AS otx
ARG OTX_RELEASE_TAG=2.6.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --branch ${OTX_RELEASE_TAG} --single-branch https://github.com/open-edge-platform/training_extensions.git
RUN cp -r /app/training_extensions/lib/src/otx/tools/templates /model_templates

FROM base AS deps-base

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0

# Install uv once for all service build stages.
COPY --link --from=ghcr.io/astral-sh/uv:0.6.12@sha256:515b886e8eb99bcf9278776d8ea41eb4553a794195ef5803aa7ca6258653100d /uv /bin/uv

# Copy shared dependency contexts to root-relative paths expected by each
# service pyproject.toml editable path dependency declarations.
COPY --link --from=libs . /libs
COPY --link --from=iai_core . /interactive_ai/libs/iai_core_py
COPY --link --from=media_utils . /interactive_ai/libs/media_utils
COPY --link --from=supported_models . /interactive_ai/supported_models

# ---------------------------------------------------------------------------
# app-source: collects all service app directories for the runtime stage.
# Separating app code from the build stages keeps venv layers lean and avoids
# re-installing deps when only application code changes.
# ---------------------------------------------------------------------------
FROM scratch AS app-source
COPY --link auto_train/app/ /interactive_ai/services/auto_train/
COPY --link dataset_ie/app/ /interactive_ai/services/dataset_ie/
COPY --link director/app/ /interactive_ai/services/director/app/
COPY --link jobs/app/ /interactive_ai/services/jobs/
COPY --link project_ie/app/ /interactive_ai/services/project_ie/
COPY --link resource/app/ /interactive_ai/services/resource/app/
COPY --link visual_prompt/app/ /interactive_ai/services/visual_prompt/
COPY --link model_registration/app/ /interactive_ai/services/model_registration/

# ---------------------------------------------------------------------------
# Build: resource  (env_core)
# ---------------------------------------------------------------------------
FROM deps-base AS build-resource
WORKDIR /interactive_ai/services/resource
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=resource/uv.lock,target=uv.lock \
    --mount=type=bind,source=resource/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: director  (env_director)
# ---------------------------------------------------------------------------
FROM deps-base AS build-director
WORKDIR /interactive_ai/services/director
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=director/uv.lock,target=uv.lock \
    --mount=type=bind,source=director/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: dataset_ie  (env_ie: shared by dataset_import_export, project_import_export)
# ---------------------------------------------------------------------------
FROM deps-base AS build-dataset_ie
WORKDIR /interactive_ai/services/dataset_ie
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=dataset_ie/uv.lock,target=uv.lock \
    --mount=type=bind,source=dataset_ie/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: jobs  (env_jobs: shared by auto_train, jobs, jobs_scheduler, jobs_policy, jobs_worker)
# ---------------------------------------------------------------------------
FROM deps-base AS build-jobs
WORKDIR /interactive_ai/services/jobs
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=jobs/uv.lock,target=uv.lock \
    --mount=type=bind,source=jobs/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: visual_prompt  (env_visual_prompt)
# ---------------------------------------------------------------------------
FROM deps-base AS build-visual_prompt
WORKDIR /interactive_ai/services/visual_prompt
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=visual_prompt/uv.lock,target=uv.lock \
    --mount=type=bind,source=visual_prompt/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: model_registration  (env_model_registration)
# ---------------------------------------------------------------------------
FROM deps-base AS build-model_registration
WORKDIR /interactive_ai/services/model_registration
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=model_registration/uv.lock,target=uv.lock \
    --mount=type=bind,source=model_registration/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: auto_train overlay  (env_auto_train)
# Start from env_core (resource) and install/copy cross-service missing deps
# required as services are migrated to a single shared env.
# ---------------------------------------------------------------------------
FROM build-resource AS build-auto_train
WORKDIR /interactive_ai/services/resource
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /interactive_ai/services/resource/.venv/bin/python --no-deps geti-configuration-tools==1.0.0
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/readerwriterlock /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/readerwriterlock
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/readerwriterlock-1.0.9.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/readerwriterlock-1.0.9.dist-info
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/sklearn /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/sklearn
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/scikit_learn-1.7.2.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/scikit_learn-1.7.2.dist-info
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/scikit_learn.libs /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/scikit_learn.libs
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/joblib /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/joblib
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/joblib-1.5.3.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/joblib-1.5.3.dist-info
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/threadpoolctl.py /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/threadpoolctl.py
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/threadpoolctl-3.6.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/threadpoolctl-3.6.0.dist-info
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/rx /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/rx
COPY --link --from=build-director /interactive_ai/services/director/.venv/lib/python3.10/site-packages/Rx-3.1.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/Rx-3.1.1.dist-info

# ---------------------------------------------------------------------------
# Runtime image
# ---------------------------------------------------------------------------
FROM base AS runtime

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        docker.io \
        ffmpeg=7:5.1.*-0+deb12u1 \
        libgl1=1.6.* \
        libglib2.0-0=2.74.* && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -l -u 10001 non-root && \
    pip3 uninstall -y setuptools pip wheel && \
    rm -rf /root/.cache/pip

# Shared editable dependency sources
COPY --link --from=deps-base --chown=10001 /libs /libs
COPY --link --from=deps-base --chown=10001 /interactive_ai/libs /interactive_ai/libs
COPY --link --from=deps-base --chown=10001 /interactive_ai/supported_models /interactive_ai/supported_models

# Grouped shared venvs (6 envs replace 8 per-service venvs)
COPY --link --from=build-auto_train --chown=10001 /interactive_ai/services/resource/.venv /interactive_ai/services/env_core/.venv
COPY --link --from=build-director --chown=10001 /interactive_ai/services/director/.venv /interactive_ai/services/env_director/.venv
COPY --link --from=build-dataset_ie --chown=10001 /interactive_ai/services/dataset_ie/.venv /interactive_ai/services/env_ie/.venv
COPY --link --from=build-jobs --chown=10001 /interactive_ai/services/jobs/.venv /interactive_ai/services/env_jobs/.venv
COPY --link --from=build-visual_prompt --chown=10001 /interactive_ai/services/visual_prompt/.venv /interactive_ai/services/env_visual_prompt/.venv
COPY --link --from=build-model_registration --chown=10001 /interactive_ai/services/model_registration/.venv /interactive_ai/services/env_model_registration/.venv

# Service app code (from app-source stage, no venvs)
COPY --link --from=app-source --chown=10001 /interactive_ai/services /interactive_ai/services

# Shared runtime data used by some services
COPY --link --from=otx /model_templates /model_templates
COPY --link --from=schemas . /interactive_ai/services/api

ENV MODEL_TEMPLATES_DIR=/model_templates

USER non-root
