# syntax=docker/dockerfile:1.7
# Shared runtime image for all interactive_ai Python API services.
# Build context: ./interactive_ai/services
# Additional contexts: libs, iai_core, media_utils, supported_models, schemas, otx
#
# Shared runtime env strategy:
#   env_core <- build-auto_train (resource base + overlays from other service envs)
#
# Other build-* stages are still used as dependency sources for selective overlay
# copies into env_core, but only env_core is copied into the final runtime image.

FROM python:3.10-slim-bookworm@sha256:23f63358922e79a794f71be8f3723c84e5ccca9638af3f74456dc73d6184499e AS base

FROM public.ecr.aws/debian/debian:12.8-slim AS otx
ARG OTX_RELEASE_TAG=2.6.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --branch ${OTX_RELEASE_TAG} --single-branch https://github.com/open-edge-platform/training_extensions.git
RUN cp -r /app/training_extensions/lib/src/otx/tools/templates /model_templates

FROM base AS deps-base

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0

# Install uv once for all service build stages.
COPY --link --from=ghcr.io/astral-sh/uv:0.6.12@sha256:515b886e8eb99bcf9278776d8ea41eb4553a794195ef5803aa7ca6258653100d /uv /bin/uv

# Copy shared dependency contexts to root-relative paths expected by each
# service pyproject.toml editable path dependency declarations.
COPY --link --from=libs . /libs
COPY --link --from=iai_core . /interactive_ai/libs/iai_core_py
COPY --link --from=media_utils . /interactive_ai/libs/media_utils
COPY --link --from=supported_models . /interactive_ai/supported_models

# ---------------------------------------------------------------------------
# app-source: collects all service app directories for the runtime stage.
# Separating app code from the build stages keeps venv layers lean and avoids
# re-installing deps when only application code changes.
# ---------------------------------------------------------------------------
FROM scratch AS app-source
COPY --link auto_train/app/ /interactive_ai/services/auto_train/
COPY --link dataset_ie/app/ /interactive_ai/services/dataset_ie/
COPY --link director/app/ /interactive_ai/services/director/app/
COPY --link jobs/app/ /interactive_ai/services/jobs/
COPY --link project_ie/app/ /interactive_ai/services/project_ie/
COPY --link resource/app/ /interactive_ai/services/resource/app/
COPY --link visual_prompt/app/ /interactive_ai/services/visual_prompt/
COPY --link model_registration/app/ /interactive_ai/services/model_registration/

# ---------------------------------------------------------------------------
# Build: resource  (env_core)
# ---------------------------------------------------------------------------
FROM deps-base AS build-resource
WORKDIR /interactive_ai/services/resource
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=resource/uv.lock,target=uv.lock \
    --mount=type=bind,source=resource/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: director  (env_director)
# ---------------------------------------------------------------------------
FROM deps-base AS build-director
WORKDIR /interactive_ai/services/director
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=director/uv.lock,target=uv.lock \
    --mount=type=bind,source=director/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: jobs  (env_jobs: shared by auto_train, jobs, jobs_scheduler, jobs_policy, jobs_worker)
# ---------------------------------------------------------------------------
FROM deps-base AS build-jobs
WORKDIR /interactive_ai/services/jobs
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=jobs/uv.lock,target=uv.lock \
    --mount=type=bind,source=jobs/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: model_registration  (env_model_registration)
# ---------------------------------------------------------------------------
FROM deps-base AS build-model_registration
WORKDIR /interactive_ai/services/model_registration
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=model_registration/uv.lock,target=uv.lock \
    --mount=type=bind,source=model_registration/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------------------
# Build: shared core overlay (final env_core source)
# Start from build-resource and install/copy service-specific runtime deps
# from other build stages into one unified venv for all API services.
# ---------------------------------------------------------------------------
FROM build-resource AS build-auto_train
WORKDIR /interactive_ai/services/resource
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /interactive_ai/services/resource/.venv/bin/python --no-deps geti-configuration-tools==1.0.0
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/readerwriterlock /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/readerwriterlock
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/readerwriterlock-1.0.9.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/readerwriterlock-1.0.9.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/celery /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/celery
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/celery-5.4.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/celery-5.4.0.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/billiard /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/billiard
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/billiard-4.2.4.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/billiard-4.2.4.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/kombu /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/kombu
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/kombu-5.6.2.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/kombu-5.6.2.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/vine /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/vine
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/vine-5.1.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/vine-5.1.0.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/amqp /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/amqp
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/amqp-5.3.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/amqp-5.3.1.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/redis /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/redis
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/redis-5.3.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/redis-5.3.1.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click-8.3.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click-8.3.1.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_didyoumean /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_didyoumean
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_didyoumean-0.3.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_didyoumean-0.3.1.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_plugins /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_plugins
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_plugins.py /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_plugins.py
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_plugins-1.1.1.2.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_plugins-1.1.1.2.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_repl /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_repl
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/click_repl-0.3.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/click_repl-0.3.0.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/prompt_toolkit /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/prompt_toolkit
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/prompt_toolkit-3.0.52.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/prompt_toolkit-3.0.52.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/wcwidth /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/wcwidth
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/wcwidth-0.6.0.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/wcwidth-0.6.0.dist-info
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/geti_k8s_tools /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/geti_k8s_tools
COPY --link --from=build-jobs /interactive_ai/services/jobs/.venv/lib/python3.10/site-packages/geti_k8s_tools-1.0.1.dist-info /interactive_ai/services/resource/.venv/lib/python3.10/site-packages/geti_k8s_tools-1.0.1.dist-info
