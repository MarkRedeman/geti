# syntax=docker/dockerfile:1.7
# Shared runtime image for all interactive_ai Python API services.
# Build context: ./interactive_ai/services
# Additional contexts: libs, iai_core, media_utils, supported_models, schemas, otx

FROM python:3.10-slim-bookworm@sha256:23f63358922e79a794f71be8f3723c84e5ccca9638af3f74456dc73d6184499e AS base

FROM public.ecr.aws/debian/debian:12.8-slim AS otx
ARG OTX_RELEASE_TAG=2.4.2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --branch ${OTX_RELEASE_TAG} --single-branch https://github.com/open-edge-platform/training_extensions.git
RUN cp -r /app/training_extensions/src/otx/tools/templates /model_templates
RUN find /model_templates -name template.yaml -type f -exec \
    sed -i -E 's/task_type:[[:space:]]*ANOMALY_(CLASSIFICATION|DETECTION|SEGMENTATION)/task_type: ANOMALY/g' {} +

FROM base AS deps-base

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0

# Install uv once for all service build stages.
COPY --link --from=ghcr.io/astral-sh/uv:0.6.12@sha256:515b886e8eb99bcf9278776d8ea41eb4553a794195ef5803aa7ca6258653100d /uv /bin/uv

# Copy shared dependency contexts to root-relative paths expected by each
# service pyproject.toml editable path dependency declarations.
COPY --link --from=libs . /libs
COPY --link --from=iai_core . /interactive_ai/libs/iai_core_py
COPY --link --from=media_utils . /interactive_ai/libs/media_utils
COPY --link --from=supported_models . /interactive_ai/supported_models

# ---------------------------------------------------------------------------
# Build: auto_train (isolated stage for better cache locality)
# ---------------------------------------------------------------------------
FROM deps-base AS build-auto_train
WORKDIR /interactive_ai/services/auto_train
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=auto_train/uv.lock,target=uv.lock \
    --mount=type=bind,source=auto_train/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link auto_train/app/ /interactive_ai/services/auto_train/

# ---------------------------------------------------------------------------
# Build: dataset_ie
# ---------------------------------------------------------------------------
FROM deps-base AS build-dataset_ie
WORKDIR /interactive_ai/services/dataset_ie
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=dataset_ie/uv.lock,target=uv.lock \
    --mount=type=bind,source=dataset_ie/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link dataset_ie/app/ /interactive_ai/services/dataset_ie/

# ---------------------------------------------------------------------------
# Build: director
# ---------------------------------------------------------------------------
FROM deps-base AS build-director
WORKDIR /interactive_ai/services/director
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=director/uv.lock,target=uv.lock \
    --mount=type=bind,source=director/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link director/app/ /interactive_ai/services/director/app/

# ---------------------------------------------------------------------------
# Build: jobs
# ---------------------------------------------------------------------------
FROM deps-base AS build-jobs
WORKDIR /interactive_ai/services/jobs
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=jobs/uv.lock,target=uv.lock \
    --mount=type=bind,source=jobs/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link jobs/app/ /interactive_ai/services/jobs/

# ---------------------------------------------------------------------------
# Build: project_ie
# ---------------------------------------------------------------------------
FROM deps-base AS build-project_ie
WORKDIR /interactive_ai/services/project_ie
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=project_ie/uv.lock,target=uv.lock \
    --mount=type=bind,source=project_ie/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link project_ie/app/ /interactive_ai/services/project_ie/

# ---------------------------------------------------------------------------
# Build: resource
# ---------------------------------------------------------------------------
FROM deps-base AS build-resource
WORKDIR /interactive_ai/services/resource
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=resource/uv.lock,target=uv.lock \
    --mount=type=bind,source=resource/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link resource/app/ /interactive_ai/services/resource/app/

# ---------------------------------------------------------------------------
# Build: visual_prompt
# ---------------------------------------------------------------------------
FROM deps-base AS build-visual_prompt
WORKDIR /interactive_ai/services/visual_prompt
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=visual_prompt/uv.lock,target=uv.lock \
    --mount=type=bind,source=visual_prompt/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link visual_prompt/app/ /interactive_ai/services/visual_prompt/

# ---------------------------------------------------------------------------
# Build: model_registration
# ---------------------------------------------------------------------------
FROM deps-base AS build-model_registration
WORKDIR /interactive_ai/services/model_registration
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=model_registration/uv.lock,target=uv.lock \
    --mount=type=bind,source=model_registration/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-editable
COPY --link model_registration/app/ /interactive_ai/services/model_registration/

# ---------------------------------------------------------------------------
# Runtime image
# ---------------------------------------------------------------------------
FROM base AS runtime

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        docker.io \
        ffmpeg=7:5.1.*-0+deb12u1 \
        libgl1=1.6.* \
        libglib2.0-0=2.74.* && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -l -u 10001 non-root && \
    pip3 uninstall -y setuptools pip wheel && \
    rm -rf /root/.cache/pip

# Shared editable dependency sources
COPY --link --from=deps-base --chown=10001 /libs /libs
COPY --link --from=deps-base --chown=10001 /interactive_ai/libs /interactive_ai/libs
COPY --link --from=deps-base --chown=10001 /interactive_ai/supported_models /interactive_ai/supported_models

# Service-specific venvs and app code
COPY --link --from=build-auto_train --chown=10001 /interactive_ai/services/auto_train /interactive_ai/services/auto_train
COPY --link --from=build-dataset_ie --chown=10001 /interactive_ai/services/dataset_ie /interactive_ai/services/dataset_ie
COPY --link --from=build-director --chown=10001 /interactive_ai/services/director /interactive_ai/services/director
COPY --link --from=build-jobs --chown=10001 /interactive_ai/services/jobs /interactive_ai/services/jobs
COPY --link --from=build-project_ie --chown=10001 /interactive_ai/services/project_ie /interactive_ai/services/project_ie
COPY --link --from=build-resource --chown=10001 /interactive_ai/services/resource /interactive_ai/services/resource
COPY --link --from=build-visual_prompt --chown=10001 /interactive_ai/services/visual_prompt /interactive_ai/services/visual_prompt
COPY --link --from=build-model_registration --chown=10001 /interactive_ai/services/model_registration /interactive_ai/services/model_registration

# Shared runtime data used by some services
COPY --link --from=otx /model_templates /model_templates
COPY --link --from=schemas . /interactive_ai/services/api

ENV MODEL_TEMPLATES_DIR=/model_templates

USER non-root
