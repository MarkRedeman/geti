#--------------------------------------------
# Build time configuration
#--------------------------------------------
# Corporate proxies
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
no_proxy=

# Project registry and version tag
TAG=main
REGISTRY=ghcr.io/geti

# Base images
NGINX_IMAGE=public.ecr.aws/nginx/nginx:1.27-bookworm
NODE_IMAGE=public.ecr.aws/docker/library/node:22.12-bookworm-slim
GO_IMAGE=public.ecr.aws/docker/library/golang:1.23.8
OTX_RELEASE_TAG=2.6.0

#--------------------------------------------
# Runtime configuration
#--------------------------------------------
# PostgreSQL (platform + SpiceDB backing store in local compose)
DB_USER=geti
DB_PASSWORD=geti
DB_NAME=geti

# MongoDB (shared DB for interactive_ai microservices)
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=root
MONGODB_DATABASE_NAME=geti
DATABASE_ADDRESS=mongodb://mongodb:27017/
DATABASE_USERNAME=geti
DATABASE_PASSWORD=geti
SERVICE_USER_ALL_DB_ROLES=readWriteAnyDatabase,dbAdminAnyDatabase

# Kafka / S3 / SpiceDB endpoints (service-to-service)
KAFKA_ADDRESS=kafka:9092
KAFKA_USERNAME=dummy
KAFKA_PASSWORD=dummy
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
GETI_NOTIFICATION_TOPIC=project_notifications
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy
S3_BUCKET=geti
SPICEDB_ADDRESS=spicedb:50051
SPICEDB_TOKEN=somerandomkeyhere
SPICEDB_CREDENTIALS=insecure

# LDAP / SMTP for platform user management flows
LDAP_HOST=openldap
LDAP_PORT=389
LDAP_ADMIN_USER=admin
LDAP_ADMIN_PASSWORD=admin
SMTP_HOST=
SMTP_PORT=1025
SMTP_LOGIN=
SMTP_PASSWORD=

# Initial user bootstrap
INITIAL_USER_EMAIL=admin@geti.local
INITIAL_USER_PASSWORD=AdminPassword123!

# Local auth mode toggle (used by compose migration)
AUTH_MODE=mock
DEPLOYMENT_MODE=compose
LOCAL_EXECUTOR_MODE=celery
LOCAL_EXECUTOR_SIM_DURATION_SEC=2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DEFAULT_TRAINER_VERSION=1.6.2
MOCK_SESSION_ORGANIZATION_ID=000000000000000000000001
MOCK_SESSION_WORKSPACE_ID=000000000000000000000001
MOCK_JOB_METADATA_ID=000000000000000000000001
MOCK_JOB_METADATA_TYPE=compose-job
MOCK_JOB_METADATA_NAME=compose-job
MOCK_JOB_METADATA_AUTHOR=000000000000000000000001
MOCK_JOB_METADATA_START_TIME=null
MOCK_USER_ID=local-admin
MOCK_USER_EMAIL=local-admin@geti.local
MOCK_USER_NAME=Local Admin
MOCK_USER_FIRST_NAME=Local
MOCK_USER_LAST_NAME=Admin
MOCK_USER_SUB=local-admin
MOCK_USER_IS_INTEL_EMPLOYEE=false

# Additional compose runtime tuning
S3_HOST=s3:8333
COMPOSE_DOCKER_NETWORK=geti
POSTGRES_PORT=5432
INIT_SEED_WEIGHTS=0
LOCAL_EXECUTOR_DEFAULT_TIMEOUT_SEC=7200
LOCAL_EXECUTOR_TRAIN_TIMEOUT_SEC=7200
LOCAL_EXECUTOR_OPTIMIZE_TIMEOUT_SEC=3600
AUTO_TRAIN_CONTROLLER_LOOP_INTERVAL=5
AUTO_TRAIN_DEBOUNCING_PERIOD=5
AUTO_TRAIN_JOB_SUBMISSION_COOLDOWN=60
TRAINER_RUNTIME_ACCELERATOR=gpu
TRAINER_RUNTIME_XPU_DEVICES=/dev/dri
SAM_ENCODER_XML_PATH=sam_vit_b_zsl_encoder.xml
SAM_ENCODER_BIN_PATH=sam_vit_b_zsl_encoder.bin
SAM_DECODER_XML_PATH=sam_vit_b_zsl_decoder.xml
SAM_DECODER_BIN_PATH=sam_vit_b_zsl_decoder.bin
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
INVITATION_FROM_ADDRESS=no-reply@geti.intel.com
INVITATION_FROM_NAME=Intel Geti
LDAP_ORGANISATION=Geti Local
LDAP_DOMAIN=example.org
USERS_PER_ORG_LIMIT=300
MAX_JOBS_RUNNING_PER_ORGANIZATION=1
SIGNING_IE_PRIVKEY="-----BEGIN EC PRIVATE KEY-----\nMIGkAgEBBDBvhcbXuDdIHzU9EDwCRP+ML3+RwHOeiJH7muQ+5BHPnvCKpblCz9WA\nSUe7b4o44DCgBwYFK4EEACKhZANiAAR9qU6ywYIcqXUOWSauI74EE6jx76+6yY7R\n1oY9tGxFIe644p1PITx0yaQKp5MKm/iXRIhV0UrWfxWpzzp2w0Pq8nlWkMC8CVBH\nSLqppAcpL0bWNjq68cd1PegegXkQtjU=\n-----END EC PRIVATE KEY-----\n"
GETI_INIT_S3_BUCKET_LIST=geti;images;videos;thumbnails;tensors;models;temporaryfiles;resultmedia;codedeployments;mlflowexperiments;pretrainedweights;vpsreferencefeatures
ACCOUNT_SERVICE_PORT=5001
INVITE_USER_EXPIRATION_SEC=43200
PASSWORD_RESET_EXPIRATION_MIN=15
SCHEDULING_POLICY_SERVICE_LOOP_INTERVAL=1
RESOURCE_MANAGER_LOOP_INTERVAL=60
WORKFLOW_EVALUATE_STUB=true
WORKFLOW_EVALUATE_STUB_METADATA=true
WORKFLOW_EVALUATE_STUB_EVALUATE=false
WORKFLOW_EVALUATE_STUB_REGISTER=false
WORKFLOW_EVALUATE_STUB_ACCEPTANCE=false
WORKFLOW_EVALUATE_STUB_TASK_INFER=false
WORKFLOW_EVALUATE_STUB_PIPELINE_INFER=false
WORKFLOW_OPTIMIZE_STUB_EVALUATE=false
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9095
